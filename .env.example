APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=local-development-secret-change-me-123456
ACCESS_TOKEN_EXPIRE_MINUTES=30
POSTGRES_PASSWORD=change-this-local-database-password
DATABASE_URL=postgresql+psycopg://docsflow:change-this-local-database-password@db:5432/docsflow
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

BACKUP_MASTER_KEY=

INIT_TEST_USER=true
TEST_USER_EMAIL=m@m.com
TEST_USER_PASSWORD=12345678

UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=redis://redis:6379/2
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTRATION_RATE_LIMIT_REQUESTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
SEMANTIC_SEARCH_RATE_LIMIT_REQUESTS=30
SEMANTIC_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
KNOWLEDGE_QUESTION_RATE_LIMIT_REQUESTS=10
KNOWLEDGE_QUESTION_RATE_LIMIT_WINDOW_SECONDS=60
OPENAI_DAILY_REQUEST_QUOTA=200
OPENAI_DAILY_TOKEN_QUOTA=500000
LOCAL_STORAGE_PATH=storage

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

DOCUMENT_PROCESSING_SOFT_TIME_LIMIT_SECONDS=60
DOCUMENT_PROCESSING_HARD_TIME_LIMIT_SECONDS=90
DOCUMENT_PROCESSING_MAX_RETRIES=3
DOCUMENT_PROCESSING_RETRY_DELAY_SECONDS=10
DOCUMENT_PREVIEW_TOKEN_EXPIRE_MINUTES=10

BACKUP_SOFT_TIME_LIMIT_SECONDS=120
BACKUP_HARD_TIME_LIMIT_SECONDS=180
BACKUP_RESTORE_MAX_FILE_SIZE_MB=25
BACKUP_RESTORE_MAX_DECOMPRESSED_SIZE_MB=100
BACKUP_RESTORE_MAX_DOCUMENTS=2000
BACKUP_RESTORE_MAX_RAW_TEXT_CHARS=2000000
BACKUP_ALLOW_LEGACY_RESTORE=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/backups/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_TOKEN_PREVIOUS_ENCRYPTION_KEYS=
GOOGLE_DRIVE_FOLDER_NAME=docflow_backup
GOOGLE_DRIVE_TIMEOUT_SECONDS=60
GOOGLE_OAUTH_STATE_EXPIRE_MINUTES=10

LOCAL_OCR_LANGUAGES=eng+deu

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_MAX_INPUT_CHARS=12000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_RAG_MODEL=gpt-5.6-terra
OPENAI_RAG_REASONING_EFFORT=high
OPENAI_RAG_MAX_CONTEXT_CHARS=24000
OPENAI_RAG_MAX_OUTPUT_TOKENS=800
KNOWLEDGE_RETRIEVAL_LIMIT=8
KNOWLEDGE_MIN_SIMILARITY=0.25
KNOWLEDGE_HISTORY_MESSAGE_LIMIT=8
KNOWLEDGE_HISTORY_TOKEN_BUDGET=1600
KNOWLEDGE_ENABLED=true
DOCUMENT_INDEXING_SOFT_TIME_LIMIT_SECONDS=120
DOCUMENT_INDEXING_HARD_TIME_LIMIT_SECONDS=180
DOCUMENT_INDEXING_BATCH_SIZE=64
DOCUMENT_CHUNK_SIZE_TOKENS=700
DOCUMENT_CHUNK_OVERLAP_TOKENS=100
